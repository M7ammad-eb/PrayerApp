<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and earlier. Salati stores device-specific location and alarm state and has no
     irreplaceable user content, so none of its private data should leave the device. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
