<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_island_expanded"
    android:padding="16dp">

    <!-- Top header row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/island_expanded_icon_box"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_island_icon_circle"
            android:gravity="center"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true">

            <ImageView
                android:id="@+id/island_expanded_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_crescent_capsule"
                android:contentDescription="@string/app_name" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_toEndOf="@id/island_expanded_icon_box"
            android:layout_marginStart="12dp"
            android:layout_centerVertical="true">

            <TextView
                android:id="@+id/island_expanded_prayer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Upcoming: Asr (العصر)"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/island_expanded_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4:15 PM • Mecca, Saudi Arabia"
                android:textColor="#A7F3D0"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Modern LIVE Pill Badge -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="● LIVE"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_island_live_badge"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />
    </RelativeLayout>

    <!-- Center prominent live countdown & glass container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_island_chronometer_box"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:padding="16dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TIME REMAINING UNTIL ADHAN"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:letterSpacing="0.08"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/island_expanded_chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#4ADE80"
            android:textSize="32sp"
            android:textStyle="bold"
            android:countDown="true"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/island_expanded_subtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prepare for prayer with Wudu &amp; Dhikr"
            android:textColor="#CBD5E1"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Action Hint -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Tap to open Prayer Times &amp; Qibla"
        android:textColor="#64748B"
        android:textSize="11sp" />

</LinearLayout>
