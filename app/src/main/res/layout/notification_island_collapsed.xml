<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_island_pill"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:gravity="center_vertical">

    <!-- Left icon badge -->
    <ImageView
        android:id="@+id/island_collapsed_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_crescent_capsule"
        android:contentDescription="@string/app_name" />

    <!-- Center prayer title & time -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/island_collapsed_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Asr • العصر"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <TextView
            android:id="@+id/island_collapsed_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4:15 PM • Mecca"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Live Live Chronometer Capsule on Right -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#2E4A3B"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:gravity="center">

        <Chronometer
            android:id="@+id/island_collapsed_chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E6C687"
            android:textSize="13sp"
            android:textStyle="bold"
            android:countDown="true" />
    </LinearLayout>

</LinearLayout>
