<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_island_pill"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:gravity="center_vertical">

    <!-- Left icon badge -->
    <LinearLayout
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_island_icon_circle"
        android:gravity="center">

        <ImageView
            android:id="@+id/island_collapsed_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_crescent_capsule"
            android:contentDescription="@string/app_name" />
    </LinearLayout>

    <!-- Center prayer title & time -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/island_collapsed_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Asr • العصر"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <TextView
            android:id="@+id/island_collapsed_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4:15 PM • Mecca"
            android:textColor="#A7F3D0"
            android:textSize="11sp"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Live Chronometer Capsule on Right -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_island_chronometer_box"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:gravity="center">

        <Chronometer
            android:id="@+id/island_collapsed_chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#4ADE80"
            android:textSize="14sp"
            android:textStyle="bold"
            android:countDown="true" />
    </LinearLayout>

</LinearLayout>
