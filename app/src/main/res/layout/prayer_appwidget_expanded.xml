<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_expanded"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background Layers -->
    <ImageView
        android:id="@+id/widget_exp_root_bg_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/shape_widget_root_bg" />

    <ImageView
        android:id="@+id/widget_exp_root_border_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/shape_widget_root_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header -->
        <RelativeLayout
            android:id="@+id/widget_exp_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp">

            <LinearLayout
                android:id="@+id/widget_exp_header_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/widget_exp_refresh_btn"
                android:gravity="start|center_vertical"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_exp_mosque_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_widget_mosque" />

                    <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                        android:id="@+id/widget_exp_location"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:ellipsize="end"
                        android:gravity="start|center_vertical"
                        android:maxLines="1"
                        android:text="Makkah, Saudi Arabia"
                        android:textAlignment="viewStart"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Inline Hijri date, shown next to location on wide (4+ column) widgets -->
                    <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                        android:id="@+id/widget_exp_hijri_inline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:ellipsize="end"
                        android:gravity="start|center_vertical"
                        android:maxLines="1"
                        android:text="• 14 Safar 1448 AH"
                        android:textAlignment="viewStart"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="11sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Stacked Hijri date, shown below location on narrower widgets -->
                <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                    android:id="@+id/widget_exp_hijri"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:maxLines="1"
                    android:text="14 Safar 1448 AH"
                    android:textAlignment="viewStart"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/widget_exp_refresh_btn"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Refresh Widget"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_refresh" />
        </RelativeLayout>

        <!-- Hero Card -->
        <FrameLayout
            android:id="@+id/widget_exp_hero_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="6dp">

            <ImageView
                android:id="@+id/widget_exp_hero_bg_img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/shape_widget_hero_bg" />

            <ImageView
                android:id="@+id/widget_exp_hero_border_img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/shape_widget_hero_border" />

            <LinearLayout
                android:id="@+id/widget_exp_hero_single_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- LinearLayout, not RelativeLayout: see prayer_appwidget_layout.xml for why. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start|center_vertical"
                        android:orientation="vertical">

                        <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                            android:id="@+id/widget_exp_next_prayer_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="start"
                            android:text="Asr"
                            android:textAlignment="viewStart"
                            android:textColor="@color/widget_text_accent"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                            android:id="@+id/widget_exp_next_prayer_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="start"
                            android:text="3:45 PM"
                            android:textAlignment="viewStart"
                            android:textColor="@color/widget_text_on_hero"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/widget_exp_countdown_container"
                        android:background="@drawable/shape_widget_pill_bg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/widget_exp_countdown_bg_img"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="fitXY"
                            android:src="@drawable/shape_widget_pill_bg" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingStart="12dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="5dp">

                            <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                                android:id="@+id/widget_exp_countdown_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="In 1h 45m"
                                android:textColor="@color/widget_text_on_accent"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                                android:id="@+id/widget_exp_status_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Remaining"
                                android:textColor="@color/widget_text_on_accent"
                                android:textSize="9sp" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- Dual mode: previous + next side by side, shown instead of the single content
                 above only when heroTimeMode=BOTH and the widget is wide enough (4+ columns). -->
            <LinearLayout
                android:id="@+id/widget_exp_hero_dual_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_exp_hero_prev_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAlignment="viewStart"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/widget_exp_hero_prev_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAlignment="viewStart"
                        android:textColor="@color/widget_text_accent"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_exp_hero_prev_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAlignment="viewStart"
                        android:textColor="@color/widget_text_on_hero"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_exp_hero_prev_since"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAlignment="viewStart"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@color/widget_text_secondary"
                    android:orientation="vertical" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_exp_hero_next_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAlignment="viewStart"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/widget_exp_hero_next_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAlignment="viewStart"
                        android:textColor="@color/widget_text_accent"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_exp_hero_next_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAlignment="viewStart"
                        android:textColor="@color/widget_text_on_hero"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_exp_hero_next_in"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAlignment="viewStart"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Schedule List: 6 prayers, each a rounded card -->
        <LinearLayout
            android:id="@+id/widget_exp_schedule_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Fajr -->
            <FrameLayout
                android:id="@+id/widget_exp_fajr_row"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="3dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_exp_fajr_bg_img"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/shape_widget_card_item_bg" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                        android:id="@+id/widget_exp_fajr_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="Fajr"
                        android:textAlignment="viewStart"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                        android:id="@+id/widget_exp_fajr_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="05:12 AM"
                        android:textAlignment="viewEnd"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="12sp" />
                </RelativeLayout>
            </FrameLayout>

            <!-- Sunrise -->
            <FrameLayout
                android:id="@+id/widget_exp_sunrise_row"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="3dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_exp_sunrise_bg_img"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/shape_widget_card_item_bg" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                        android:id="@+id/widget_exp_sunrise_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="Sunrise"
                        android:textAlignment="viewStart"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                        android:id="@+id/widget_exp_sunrise_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="06:34 AM"
                        android:textAlignment="viewEnd"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="12sp" />
                </RelativeLayout>
            </FrameLayout>

            <!-- Dhuhr -->
            <FrameLayout
                android:id="@+id/widget_exp_dhuhr_row"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="3dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_exp_dhuhr_bg_img"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/shape_widget_card_item_bg" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                        android:id="@+id/widget_exp_dhuhr_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="Dhuhr"
                        android:textAlignment="viewStart"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                        android:id="@+id/widget_exp_dhuhr_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="12:20 PM"
                        android:textAlignment="viewEnd"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="12sp" />
                </RelativeLayout>
            </FrameLayout>

            <!-- Asr -->
            <FrameLayout
                android:id="@+id/widget_exp_asr_row"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="3dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_exp_asr_bg_img"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/shape_widget_card_item_bg" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                        android:id="@+id/widget_exp_asr_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="Asr"
                        android:textAlignment="viewStart"
                        android:textColor="@color/widget_text_on_accent"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                        android:id="@+id/widget_exp_asr_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="03:45 PM"
                        android:textAlignment="viewEnd"
                        android:textColor="@color/widget_text_on_accent"
                        android:textSize="12sp" />
                </RelativeLayout>
            </FrameLayout>

            <!-- Maghrib -->
            <FrameLayout
                android:id="@+id/widget_exp_maghrib_row"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="3dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_exp_maghrib_bg_img"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/shape_widget_card_item_bg" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                        android:id="@+id/widget_exp_maghrib_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="Maghrib"
                        android:textAlignment="viewStart"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                        android:id="@+id/widget_exp_maghrib_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="06:05 PM"
                        android:textAlignment="viewEnd"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="12sp" />
                </RelativeLayout>
            </FrameLayout>

            <!-- Isha -->
            <FrameLayout
                android:id="@+id/widget_exp_isha_row"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_exp_isha_bg_img"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/shape_widget_card_item_bg" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                        android:id="@+id/widget_exp_isha_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="Isha"
                        android:textAlignment="viewStart"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                        android:id="@+id/widget_exp_isha_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="07:35 PM"
                        android:textAlignment="viewEnd"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="12sp" />
                </RelativeLayout>
            </FrameLayout>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
