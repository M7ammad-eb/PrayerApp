<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background Layers -->
    <ImageView
        android:id="@+id/widget_root_bg_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/shape_widget_root_bg" />

    <ImageView
        android:id="@+id/widget_root_border_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/shape_widget_root_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header: Location, Hijri Date, and Refresh Action -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/widget_header_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/widget_refresh_button"
                android:gravity="start|center_vertical"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_mosque_icon"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_widget_mosque" />

                    <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                        android:id="@+id/widget_location_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:ellipsize="end"
                        android:gravity="start|center_vertical"
                        android:maxLines="1"
                        android:text="Makkah, Saudi Arabia"
                        android:textAlignment="viewStart"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- Inline Hijri date, shown next to location on wide (4+ column) widgets -->
                    <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                        android:id="@+id/widget_hijri_text_inline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:ellipsize="end"
                        android:gravity="start|center_vertical"
                        android:maxLines="1"
                        android:text="• 14 Safar 1448 AH"
                        android:textAlignment="viewStart"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="10sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Stacked Hijri date, shown below location on narrower widgets -->
                <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                    android:id="@+id/widget_hijri_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:maxLines="1"
                    android:text="14 Safar 1448 AH"
                    android:textAlignment="viewStart"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/widget_refresh_button"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Refresh Widget"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_refresh" />
        </RelativeLayout>

        <!-- Hero Card: Next Prayer Details & Countdown -->
        <FrameLayout
            android:id="@+id/widget_hero_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <ImageView
                android:id="@+id/widget_hero_bg_img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/shape_widget_hero_bg" />

            <ImageView
                android:id="@+id/widget_hero_border_img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/shape_widget_hero_border" />

            <LinearLayout
                android:id="@+id/widget_hero_single_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- LinearLayout, not RelativeLayout: a RelativeLayout child that is
                     wrap_content but itself contains a match_parent descendant (the countdown
                     pill's background ImageView) can fail to size that descendant correctly.
                     LinearLayout's weight-based sizing is what the ribbon cells already use
                     successfully, so the countdown pill's background is given the same
                     unambiguous sizing here. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Next Prayer Label & Time -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start|center_vertical"
                        android:orientation="vertical">

                        <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                            android:id="@+id/widget_next_prayer_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="start"
                            android:text="Asr"
                            android:textAlignment="viewStart"
                            android:textColor="@color/widget_text_accent"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                            android:id="@+id/widget_next_prayer_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:gravity="start"
                            android:text="3:45 PM"
                            android:textAlignment="viewStart"
                            android:textColor="@color/widget_text_on_hero"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Countdown Timer Badge -->
                    <FrameLayout
                        android:id="@+id/widget_countdown_container"
                        android:background="@drawable/shape_widget_pill_bg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/widget_countdown_bg_img"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="fitXY"
                            android:src="@drawable/shape_widget_pill_bg" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp">

                            <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                                android:id="@+id/widget_countdown_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="In 1h 45m"
                                android:textColor="@color/widget_text_on_accent"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                                android:id="@+id/widget_status_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Remaining"
                                android:textColor="@color/widget_text_on_accent"
                                android:textSize="8sp" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>

                <!-- Interval Progress Bar -->
                <ProgressBar
                    android:id="@+id/widget_prayer_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="65"
                    android:progressDrawable="@drawable/widget_progress_bar" />
            </LinearLayout>

            <!-- Dual mode: previous + next side by side, shown instead of the single content
                 above only when heroTimeMode=BOTH and the widget is wide enough (4+ columns). -->
            <LinearLayout
                android:id="@+id/widget_hero_dual_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="10dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_hero_prev_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAlignment="viewStart"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/widget_hero_prev_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAlignment="viewStart"
                        android:textColor="@color/widget_text_accent"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_hero_prev_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:textAlignment="viewStart"
                        android:textColor="@color/widget_text_on_hero"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_hero_prev_since"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAlignment="viewStart"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@color/widget_text_secondary"
                    android:orientation="vertical" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_hero_next_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAlignment="viewStart"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/widget_hero_next_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAlignment="viewStart"
                        android:textColor="@color/widget_text_accent"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_hero_next_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:textAlignment="viewStart"
                        android:textColor="@color/widget_text_on_hero"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_hero_next_in"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAlignment="viewStart"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Daily Prayer Times Ribbon. No fixed weightSum: when Sunrise is hidden (GONE), the
             weight total must shrink from 6 to 5 so the remaining cells expand to fill the row
             instead of leaving a blank gap where Sunrise used to be. -->
        <LinearLayout
            android:id="@+id/widget_prayer_ribbon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Fajr -->
            <FrameLayout
                android:id="@+id/widget_fajr_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="3dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_fajr_bg_img"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/shape_widget_card_item_bg" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="5dp">

                    <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                        android:id="@+id/widget_fajr_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Fajr"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                        android:id="@+id/widget_fajr_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="05:12"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="9sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Sunrise -->
            <FrameLayout
                android:id="@+id/widget_sunrise_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="3dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_sunrise_bg_img"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/shape_widget_card_item_bg" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="5dp">

                    <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                        android:id="@+id/widget_sunrise_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Sunrise"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                        android:id="@+id/widget_sunrise_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="06:34"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="9sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Dhuhr -->
            <FrameLayout
                android:id="@+id/widget_dhuhr_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="3dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_dhuhr_bg_img"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/shape_widget_card_item_bg" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="5dp">

                    <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                        android:id="@+id/widget_dhuhr_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Dhuhr"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                        android:id="@+id/widget_dhuhr_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="12:20"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="9sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Asr -->
            <FrameLayout
                android:id="@+id/widget_asr_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="3dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_asr_bg_img"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/shape_widget_card_item_bg" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="5dp">

                    <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                        android:id="@+id/widget_asr_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Asr"
                        android:textColor="@color/widget_text_on_accent"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                        android:id="@+id/widget_asr_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="15:45"
                        android:textColor="@color/widget_text_on_accent"
                        android:textSize="9sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Maghrib -->
            <FrameLayout
                android:id="@+id/widget_maghrib_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="3dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_maghrib_bg_img"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/shape_widget_card_item_bg" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="5dp">

                    <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                        android:id="@+id/widget_maghrib_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Maghrib"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                        android:id="@+id/widget_maghrib_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="18:05"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="9sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Isha -->
            <FrameLayout
                android:id="@+id/widget_isha_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_isha_bg_img"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/shape_widget_card_item_bg" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="5dp">

                    <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                        android:id="@+id/widget_isha_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Isha"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                        android:id="@+id/widget_isha_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="19:35"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="9sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
