<?xml version="1.0" encoding="utf-8"?>
<!-- Real outline (transparent fill + opaque stroke) so tinting only colors the ring, not the
     whole card - required for the "Border Outline Only" background style to look like an
     actual outline rather than a solid wash. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#00000000" />
    <stroke
        android:width="2dp"
        android:color="#FFFFFFFF" />
    <corners android:radius="24dp" />
</shape>
